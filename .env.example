# ==============================================================================
# WildShield AI — Full-Stack Deployment Environment Blueprint
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Set in Vercel Project Settings)
# ------------------------------------------------------------------------------
# The public URL of your deployed FastAPI backend (Render / Railway / Fly.io / VPS)
# When set, the frontend automatically routes all REST and WebSocket calls here.
# If omitted or on localhost, the frontend falls back to http://localhost:8000/api
VITE_API_URL=https://your-wildshield-backend.onrender.com/api

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Set in Render / Railway / Backend Host)
# ------------------------------------------------------------------------------
# Managed PostgreSQL database URL (Render / Supabase / Neon / Railway)
DATABASE_URL=postgresql://username:password@host:5432/wildshield?sslmode=require

# JWT Secret Key (generate with `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=generate-a-strong-random-secret-key-for-production

# CORS: Add your exact Vercel frontend URL
CORS_ORIGINS=https://wildshield-ai.vercel.app,http://localhost:5173,http://localhost:5500
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# Optional Services
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional Roboflow AI
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_WORKFLOW=

# Optional Edge device ingestion key
EDGE_API_KEY=
