# ==============================================================================
# WildShield AI — Backend Environment Configuration Example
# Copy this file to .env before starting the backend in production.
# NEVER commit your actual .env file or private credentials to GitHub.
# ==============================================================================

# --- Database ---
# Local SQLite fallback (ephemeral - not suitable for serverless or multi-container)
DATABASE_URL=sqlite:///./wildshield.db
# Production Managed PostgreSQL (e.g. Supabase / Neon / Render / Railway)
# DATABASE_URL=postgresql://username:password@ep-host.region.aws.neon.tech/wildshield?sslmode=require

# --- Authentication & Security ---
# Generate a secure 32+ character key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Cross-Origin Resource Sharing (CORS) ---
# Comma-separated origins allowed to call the backend. Add your Vercel production URL:
CORS_ORIGINS=https://wildshield-ai.vercel.app,http://localhost:5173,http://localhost:3000,http://localhost:5500
# Regex to allow all Vercel preview branches automatically:
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# --- SMS Notification Provider ---
# mock: Logs SMS messages to terminal (default for development/demo)
# twilio: Dispatches actual SMS via Twilio API
# gsm_module: Triggers hardware GSM SIM900/SIM800 serial module
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Computer Vision & AI Inference (Roboflow / Edge) ---
# Optional: Set these if using hosted Roboflow workflows. Keep private on the backend.
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_WORKFLOW=

# Optional: Shared secret key for edge camera device ingestion (/api/detections)
EDGE_API_KEY=

# --- Alert Engine & Siren Settings ---
DEFAULT_CONFIDENCE_THRESHOLD=0.6
DEFAULT_COOLDOWN_SECONDS=90
DEFAULT_SIREN_DURATION_SECONDS=45
